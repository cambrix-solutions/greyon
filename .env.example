# Frontend (Quasar)
# Leave USE_API unset/false to run on Pinia mock only.

# VITE_USE_API=true
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_GTM_ID=

# Maintenance mode (build-time). Prefer editing public/maintenance.json on the
# server for deploy-time toggles without rebuilding.
# VITE_MAINTENANCE=true
# VITE_MAINTENANCE_MESSAGE=We are updating Greyon. Back shortly.
# VITE_MAINTENANCE_ETA=Back around 10:00 ICT
