# Frontend (Quasar) → greyon-engine only
#
# Quasar Vite 3 exposes only the clientPrefix (set to VITE_ in quasar.config.ts).
# VITE_APP_MODE selects hosts in src/helpers/api/apiConfig.ts (local | staging | production)
#
# The SPA always uses the engine API (mock/Pinia seeds removed).
# VITE_USE_API is kept for compatibility and should remain true.

VITE_APP_MODE=local
VITE_USE_API=true

# Optional: Vite `/engine` proxy target (Node-side; not exposed to the browser).
# Default is https://greyon-engine.test — requires that host in your hosts file.
# ENGINE_PROXY_TARGET=http://127.0.0.1:8088

# Optional: call Herd directly instead of the /engine proxy (needs trusted cert + CORS):
# VITE_ENGINE_URL=https://greyon-engine.test

# Absolute engine host for Google OAuth browser redirect (local Herd default):
# VITE_ENGINE_PUBLIC_URL=https://greyon-engine.test

# VITE_GTM_ID=

# ---------------------------------------------------------------------------
# Coolify (production) — set as BUILD arguments on the SPA application
# See docs/COOLIFY.md
# ---------------------------------------------------------------------------
# VITE_APP_MODE=production
# VITE_USE_API=true
# VITE_ENGINE_URL=https://engine.greyon.site
# VITE_ENGINE_PUBLIC_URL=https://engine.greyon.site
